; Engine configuration file.
; Godot 4.3, Mobile renderer, iOS-first.

config_version=5

[application]

config/name="Код 211"
config/description="Тактический шутер: полицейский против грабителей мини-маркета."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.039, 0.059, 0.09, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Save="*res://scripts/autoload/save_data.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="bandits"
3d_physics/layer_4="civilians"
3d_physics/layer_5="glass"
3d_render/layer_1="exterior"
3d_render/layer_2="interior"

[navigation]

3d/default_cell_size=0.15
3d/default_cell_height=0.1

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.039, 0.059, 0.09, 1)
limits/opengl/max_renderable_lights=32
